NODE_ENV=production
PORT=5000

POSTGRES_DB=azuredrop
POSTGRES_USER=azuredrop
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

DATABASE_URL=postgresql://azuredrop:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/azuredrop

DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

CORS_ORIGINS=https://YOUR_PUBLIC_HOST
PUBLIC_BASE_URL=https://YOUR_PUBLIC_HOST

MAX_FILE_SIZE_MB=10

SHARE_DEFAULT_EXPIRY_MINUTES=60
SHARE_MAX_EXPIRY_MINUTES=10080

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=azuredrop-files

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=AZURITE_DEVELOPMENT_KEY;BlobEndpoint=http://azurite:10000/devstoreaccount1;

AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=https://YOUR_PUBLIC_HOST/blob/devstoreaccount1

AZUREDROP_HTTP_PORT=80
AZUREDROP_HTTPS_PORT=443
