# AzureDrop environment example

NODE_ENV=development
PORT=5000

# PostgreSQL

POSTGRES_DB=azuredrop
POSTGRES_USER=azuredrop
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql://azuredrop:change-this-password@postgres:5432/azuredrop

# Local PostgreSQL does not require TLS.
# Set DATABASE_SSL=true for Azure PostgreSQL.

DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Authentication

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# Browser access
# Comma-separate multiple allowed origins.

CORS_ORIGINS=http://localhost:5173

# Public API / reverse-proxy origin used when creating
# temporary share download URLs.

PUBLIC_BASE_URL=http://localhost:5001

# Upload configuration

MAX_FILE_SIZE_MB=10

SHARE_DEFAULT_EXPIRY_MINUTES=60
SHARE_MAX_EXPIRY_MINUTES=10080

# Azure Blob Storage
#
# Production with Managed Identity:
# leave AZURE_STORAGE_CONNECTION_STRING empty and set
# AZURE_STORAGE_ACCOUNT_NAME.
#
# Local development:
# use the Azurite connection string instead.

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=azuredrop-files

AZURE_STORAGE_CONNECTION_STRING=

# Local Azurite public endpoint.
# Leave empty in normal Azure production deployment.

AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1
